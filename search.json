---
title: search
layout: none
search: exclude
---

{% assign documents = site.pages | concat: site.posts | where_exp: "item", "item.search != 'exclude'" | where_exp: "item", "item.title != nil" | where_exp: "item", "item.title != ''" %}
[
{% for item in documents %}
{
"title": {{ item.title | jsonify }},
"tags": {{ item.tags | join: ', ' | default: '' | jsonify }},
"keywords": {{ item.keywords | default: '' | jsonify }},
"url": {{ item.url | relative_url | jsonify }},
"summary": {{ item.summary | default: '' | strip | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
